&GLOBAL
   PROJECT ZnO
   RUN_TYPE ENERGY_FORCE
   PRINT_LEVEL LOW
   EXTENDED_FFT_LENGTHS TRUE
&END GLOBAL

&FORCE_EVAL
   METHOD Quickstep
   STRESS_TENSOR ANALYTICAL
   &DFT
      BASIS_SET_FILE_NAME  BASIS_MOLOPT_UZH
      POTENTIAL_FILE_NAME  POTENTIAL_UZH
      &MGRID
        CUTOFF 900
        REL_CUTOFF 60
      &END MGRID

      &QS
        EPS_DEFAULT 1.0E-12
      &END QS

      &SCF
         EPS_SCF 1.0E-6
         SCF_GUESS ATOMIC
         MAX_SCF 500
         &OUTER_SCF
           EPS_SCF 1.0E-6
           MAX_SCF 5
         &END
         &OT ON
           PRECONDITIONER FULL_SINGLE_INVERSE
           MINIMIZER DIIS
           ENERGY_GAP 0.1
           STEPSIZE 0.1
         &END OT
      &END SCF
      &XC
         &XC_FUNCTIONAL
            &MGGA_X_r2SCAN
            &END
            &MGGA_C_r2SCAN
            &END
         &END XC_FUNCTIONAL
      &END XC
   &END DFT

   &SUBSYS
      &PRINT
        &ATOMIC_COORDINATES ON
        &END ATOMIC_COORDINATES
        &CELL ON
        &END CELL
      &END PRINT
#      &CELL
#        ABC 13.128 10.582 47.05377225
#        PERIODIC XYZ
#      &END CELL
#      &TOPOLOGY
#        COORD_FILE_FORMAT XYZ
#        COORD_FILE_NAME snapshot_6.xyz
#        CONN_FILE_FORMAT OFF
#      &END TOPOLOGY
      &KIND O
        BASIS_SET DZVP-MOLOPT-SCAN-GTH-q6
        POTENTIAL GTH-SCAN-q6
      &END KIND
      &KIND Zn
        BASIS_SET DZVP-MOLOPT-SCAN-GTH-q12
        POTENTIAL GTH-SCAN-q12
      &END KIND
      &KIND H
        BASIS_SET DZVP-MOLOPT-SCAN-GTH-q1
        POTENTIAL GTH-SCAN-q1
      &END KIND
      &KIND Na
        BASIS_SET DZVP-MOLOPT-SCAN-GTH-q9
        POTENTIAL GTH-SCAN-q9
      &END KIND
      &KIND Cl
        BASIS_SET DZVP-MOLOPT-SCAN-GTH-q7
        POTENTIAL GTH-SCAN-q7
      &END KIND
   &END SUBSYS

   &PRINT
     &FORCES ON
     &END FORCES
     &STRESS_TENSOR ON
     &END STRESS_TENSOR
   &END PRINT

&END FORCE_EVAL
